+// LSCreateOpenToE2EEThreadLink links a Facebook 1:1 thread to its end-to-end encrypted (WhatsApp-protocol)
+// counterpart. Sent in sync group 95; for chats that were encrypted from the start it's the only record of
+// the thread, so without it those chats are never bridged until a new message arrives.
+type LSCreateOpenToE2EEThreadLink struct {
+	ThreadKey               int64 `index:"0" json:",omitempty"`
+	ThreadJID               int64 `index:"1" json:",omitempty"`
+	IsOpen                  bool  `index:"2" json:",omitempty"`
+	LastActivityTimestampMS int64 `index:"3" json:",omitempty"`
+
+	Unrecognized map[int]any `json:",omitempty"`
+}
+
