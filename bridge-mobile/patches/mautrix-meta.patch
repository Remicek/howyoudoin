diff --git a/pkg/connector/history_provisioning.go b/pkg/connector/history_provisioning.go
new file mode 100644
index 0000000..59f03dc
--- /dev/null
+++ b/pkg/connector/history_provisioning.go
@@ -0,0 +1,197 @@
+package connector
+
+// HowYouDoin addition: restore end-to-end encrypted Messenger history with the secure storage PIN at any time,
+// not only as the last login step. Exposed on the provisioning API:
+//
+//	GET  /_matrix/provision/v3/messenger/history          -> {"restored": bool, "backup_available": bool}
+//	POST /_matrix/provision/v3/messenger/history/restore  {"pin": "123456"}
+//
+// After a successful restore, existing encrypted chats get a fresh Matrix room so the initial backfill brings in
+// the decrypted history (homeservers without batch sending can't insert history into an existing room).
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"sync"
+
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/matrix"
+	"maunium.net/go/mautrix/bridgev2/simplevent"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/httpclient"
+	"go.mau.fi/mautrix-meta/pkg/messagix/securehistory"
+	"go.mau.fi/mautrix-meta/pkg/messagix/types"
+	"go.mau.fi/mautrix-meta/pkg/metaid"
+)
+
+var (
+	errHistoryWrongPIN = mautrix.RespError{ErrCode: "FI.MAU.META.HISTORY_WRONG_PIN", Err: "Couldn't verify your PIN", StatusCode: http.StatusForbidden}
+	errHistoryPINLimit = mautrix.RespError{ErrCode: "FI.MAU.META.HISTORY_PIN_LIMIT", Err: "No PIN attempts remaining", StatusCode: http.StatusForbidden}
+	errHistoryNoBackup = mautrix.RespError{ErrCode: "FI.MAU.META.HISTORY_NO_BACKUP", Err: "This account has no PIN-protected history backup", StatusCode: http.StatusNotFound}
+	errHistoryInvalid  = mautrix.RespError{ErrCode: "M_INVALID_PARAM", Err: "Enter your six-digit PIN", StatusCode: http.StatusBadRequest}
+	errHistoryNotMeta  = mautrix.RespError{ErrCode: "M_BAD_STATE", Err: "Encrypted history is only available for Messenger logins", StatusCode: http.StatusBadRequest}
+	errHistoryRelogin  = mautrix.RespError{ErrCode: "FI.MAU.META.TOKEN_INVALIDATED", Err: "The Messenger session expired, sign in again", StatusCode: http.StatusUnauthorized}
+	errHistoryBusy     = mautrix.RespError{ErrCode: "FI.MAU.META.HISTORY_BUSY", Err: "Encrypted history is already being restored", StatusCode: http.StatusConflict}
+)
+
+// historyRestoresInFlight holds the IDs of logins whose history restore (or the room rebuild after it) is running.
+var historyRestoresInFlight sync.Map
+
+func (m *MetaConnector) registerHistoryProvisioning() {
+	withProv, ok := m.Bridge.Matrix.(bridgev2.MatrixConnectorWithProvisioning)
+	if !ok {
+		return
+	}
+	prov, ok := withProv.GetProvisioning().(*matrix.ProvisioningAPI)
+	if !ok || prov == nil || prov.Router == nil {
+		return
+	}
+	prov.Router.HandleFunc("GET /v3/messenger/history", func(w http.ResponseWriter, r *http.Request) {
+		client := historyClientForRequest(prov, w, r)
+		if client == nil {
+			return
+		}
+		restored := client.canBackfillEncrypted()
+		available := restored
+		if !restored {
+			_, err := client.Client.GetSecureHistoryClient().GetBackup(r.Context())
+			if err != nil && !errors.Is(err, securehistory.ErrNoPINBackup) {
+				writeHistoryError(w, client, err, "Failed to check Messenger encrypted history")
+				return
+			}
+			available = err == nil
+		}
+		writeJSON(w, http.StatusOK, map[string]bool{"restored": restored, "backup_available": available})
+	})
+	prov.Router.HandleFunc("POST /v3/messenger/history/restore", func(w http.ResponseWriter, r *http.Request) {
+		client := historyClientForRequest(prov, w, r)
+		if client == nil {
+			return
+		}
+		var req struct {
+			PIN string `json:"pin"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil || !historyPINPattern.MatchString(req.PIN) {
+			errHistoryInvalid.Write(w)
+			return
+		}
+		pin := []byte(req.PIN)
+		req.PIN = ""
+		// One restore per login at a time: a second request (a retry, a double tap) would spend another PIN attempt
+		// and start a second rebuild that deletes the rooms the first one is recreating.
+		if _, busy := historyRestoresInFlight.LoadOrStore(client.UserLogin.ID, struct{}{}); busy {
+			errHistoryBusy.Write(w)
+			return
+		}
+		release := func() { historyRestoresInFlight.Delete(client.UserLogin.ID) }
+		if client.canBackfillEncrypted() {
+			// Already restored, and the encrypted rooms were rebuilt then: rebuilding again would only throw every
+			// encrypted room away and backfill it once more.
+			release()
+			writeJSON(w, http.StatusOK, map[string]bool{"restored": true})
+			return
+		}
+		if err := (&MessengerHistoryLogin{}).restoreHistory(r.Context(), client, pin); err != nil {
+			release()
+			writeHistoryError(w, client, err, "Failed to restore Messenger encrypted history")
+			return
+		} else if !client.canBackfillEncrypted() {
+			release()
+			writeHistoryError(w, client, errors.New("history enrollment is unconfirmed"), "Messenger history enrollment unconfirmed")
+			return
+		}
+		go func() {
+			defer release()
+			client.rebuildEncryptedPortals(context.WithoutCancel(r.Context()))
+		}()
+		writeJSON(w, http.StatusOK, map[string]bool{"restored": true})
+	})
+}
+
+func historyClientForRequest(prov *matrix.ProvisioningAPI, w http.ResponseWriter, r *http.Request) *MetaClient {
+	login := prov.GetLoginForRequest(w, r)
+	if login == nil {
+		return nil
+	}
+	client, ok := login.Client.(*MetaClient)
+	if !ok || !client.LoginMeta.Platform.IsMessenger() || client.Client == nil {
+		errHistoryNotMeta.Write(w)
+		return nil
+	}
+	return client
+}
+
+func writeHistoryError(w http.ResponseWriter, client *MetaClient, err error, message string) {
+	client.UserLogin.Log.Warn().Err(err).Msg(message)
+	var recoveryErr *securehistory.RecoveryError
+	switch {
+	case errors.Is(err, securehistory.ErrNoPINBackup):
+		errHistoryNoBackup.Write(w)
+	case errors.Is(err, types.ErrPleaseLogIn), errors.Is(err, httpclient.ErrTokenInvalidated):
+		errHistoryRelogin.Write(w)
+	case errors.As(err, &recoveryErr) && recoveryErr.AttemptsRemaining != nil:
+		if *recoveryErr.AttemptsRemaining == 0 {
+			errHistoryPINLimit.Write(w)
+		} else {
+			writeJSON(w, errHistoryWrongPIN.StatusCode, map[string]any{
+				"errcode":            errHistoryWrongPIN.ErrCode,
+				"error":              errHistoryWrongPIN.Err,
+				"attempts_remaining": *recoveryErr.AttemptsRemaining,
+			})
+		}
+	default:
+		mautrix.MUnknown.WithMessage("Couldn't restore encrypted history").Write(w)
+	}
+}
+
+func writeJSON(w http.ResponseWriter, status int, body any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(body)
+}
+
+// rebuildEncryptedPortals gives every existing encrypted chat a new room; the portal (and its thread metadata)
+// is kept, so the resync recreates the room and its initial backfill reads the restored history.
+func (m *MetaClient) rebuildEncryptedPortals(ctx context.Context) {
+	log := m.UserLogin.Log.With().Str("action", "rebuild encrypted portals").Logger()
+	ctx = log.WithContext(ctx)
+	userPortals, err := m.Main.Bridge.DB.UserPortal.GetAllForLogin(ctx, m.UserLogin.UserLogin)
+	if err != nil {
+		log.Err(err).Msg("Failed to list portals")
+		return
+	}
+	rebuilt := 0
+	for _, userPortal := range userPortals {
+		portal, err := m.Main.Bridge.GetExistingPortalByKey(ctx, userPortal.Portal)
+		if err != nil {
+			log.Err(err).Msg("Failed to get portal")
+			continue
+		} else if portal == nil || portal.MXID == "" || !portal.Metadata.(*metaid.PortalMetadata).ThreadType.IsWhatsApp() {
+			continue
+		}
+		oldMXID := portal.MXID
+		if err = m.Main.Bridge.Bot.DeleteRoom(ctx, oldMXID, false); err != nil {
+			log.Err(err).Stringer("room_id", oldMXID).Msg("Failed to clean up old room")
+		}
+		if err = portal.RemoveMXID(ctx); err != nil {
+			log.Err(err).Stringer("room_id", oldMXID).Msg("Failed to detach old room")
+			continue
+		}
+		if err = m.Main.Bridge.DB.Message.DeleteInChunks(ctx, portal.PortalKey); err != nil {
+			log.Err(err).Stringer("room_id", oldMXID).Msg("Failed to forget old messages")
+		}
+		m.UserLogin.QueueRemoteEvent(&simplevent.ChatResync{
+			EventMeta: simplevent.EventMeta{
+				Type:         bridgev2.RemoteEventChatResync,
+				PortalKey:    portal.PortalKey,
+				CreatePortal: true,
+			},
+		})
+		rebuilt++
+		log.Debug().Stringer("old_room_id", oldMXID).Msg("Queued encrypted portal rebuild")
+	}
+	log.Info().Int("count", rebuilt).Msg("Rebuilding encrypted portals with restored history")
+}
diff --git a/pkg/connector/opene2ee.go b/pkg/connector/opene2ee.go
new file mode 100644
index 0000000..407fe1c
--- /dev/null
+++ b/pkg/connector/opene2ee.go
@@ -0,0 +1,55 @@
+package connector
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/whatsmeow/types"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/simplevent"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+)
+
+// handleOpenToE2EEThreadLinks persists the Facebook thread ↔ encrypted chat mapping from
+// LSCreateOpenToE2EEThreadLink and creates portals for encrypted DMs the bridge doesn't have yet.
+func (m *MetaClient) handleOpenToE2EEThreadLinks(ctx context.Context, links []*table.LSCreateOpenToE2EEThreadLink) []bridgev2.RemoteEvent {
+	if len(links) == 0 {
+		return nil
+	}
+	m.UserLogin.Log.Debug().Int("count", len(links)).Msg("Got open-to-E2EE thread links")
+	events := make([]bridgev2.RemoteEvent, 0, len(links))
+	for _, link := range links {
+		if link.ThreadKey == 0 || link.ThreadJID == 0 {
+			continue
+		}
+		log := m.UserLogin.Log.With().Int64("thread_key", link.ThreadKey).Int64("thread_jid", link.ThreadJID).Logger()
+		if err := m.Main.DB.PutHybridThreadMapping(ctx, m.UserLogin.ID, link.ThreadKey, link.ThreadJID, int64(table.ENCRYPTED_OVER_WA_ONE_TO_ONE)); err != nil {
+			log.Warn().Err(err).Msg("Failed to persist open-to-E2EE thread mapping")
+		}
+		portalKey := m.makeFBPortalKey(link.ThreadJID, table.ENCRYPTED_OVER_WA_ONE_TO_ONE)
+		if portal, err := m.Main.Bridge.GetExistingPortalByKey(ctx, portalKey); err != nil {
+			log.Warn().Err(err).Msg("Failed to check for existing encrypted portal")
+			continue
+		} else if portal != nil && portal.MXID != "" {
+			continue
+		}
+		jid := types.NewJID(strconv.FormatInt(link.ThreadJID, 10), types.MessengerServer)
+		log.Debug().Msg("Creating portal for encrypted DM from open-to-E2EE thread link")
+		events = append(events, &simplevent.ChatResync{
+			EventMeta: simplevent.EventMeta{
+				Type:         bridgev2.RemoteEventChatResync,
+				PortalKey:    portalKey,
+				CreatePortal: true,
+				LogContext: func(c zerolog.Context) zerolog.Context {
+					return c.Str("resync_reason", "open-to-E2EE thread link")
+				},
+			},
+			ChatInfo:        m.makeWADirectChatInfo(ctx, jid),
+			LatestMessageTS: time.UnixMilli(link.LastActivityTimestampMS),
+		})
+	}
+	return events
+}
