{
  // The worker (src/) and its tests; the page has its own (web/tsconfig.json). Run `npm run types` first.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    // Node runs the tests by stripping types, which can't do the rest
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "lib": ["es2024"],
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["src", "test"]
}
