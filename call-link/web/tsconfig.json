{
  // The call page and its encryption worker, which run in the browser.
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["."]
}
