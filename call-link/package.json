{
  "name": "howyoudoin-call-link",
  "private": true,
  "description": "Calls through a link: the Cloudflare Worker that runs each call over Cloudflare Realtime SFU, and the call page",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.160.0"
  }
}
