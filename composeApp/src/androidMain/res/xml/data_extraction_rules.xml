<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the saved logins (see AndroidLoginBackup), and to the cloud only when end-to-end encrypted -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="login-backup/logins.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="login-backup/logins.json" />
    </device-transfer>
</data-extraction-rules>
